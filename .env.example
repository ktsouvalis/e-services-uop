# This app is normally run via Docker Compose (see ../developing or
# ../production), which injects its own outer .env into this container —
# this file is only a fallback for running `php artisan` directly outside
# Docker, so it's kept in sync with that outer .env.example's variable set
# rather than Laravel's stock scaffold defaults.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dgu
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REVERB_APP_ID=dev-app
REVERB_APP_KEY=dev-key
REVERB_APP_SECRET=dev-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY=dev-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

LDAP_HOST=your_ldap_host
LDAP_PORT=your_ldap_port
LDAP_SSL=true_or_false
LDAP_USERNAME=your_ldap_username
LDAP_PASSWORD=your_ldap_password
LDAP_BASE_DN=  your_ldap_base_dn

# ── Pangolin — Integration API only (see config/pangolin.php). Monitor/Logs,
# the old SSH/Newt/Postgres/multi-node HA setup were all removed 2026-09-22
# — Import/Normalize only ever talk to this Integration API. It is NOT the
# same as your Pangolin dashboard's public URL/API: the Integration API is a
# separate backend port that most reverse-proxy setups don't expose
# publicly, reached here via the pangolin-tunnel compose service's SSH
# local-forward (see docker-compose.yml) rather than a public URL.
PANGOLIN_API_BASE_URL=http://pangolin-tunnel:3003
PANGOLIN_ORG_SLUG=your_org_slug
PANGOLIN_API_KEY=your_api_key

# pangolin-tunnel's SSH target — the host running Pangolin, and the
# Integration API's own address as reachable FROM that host (its container's
# bridge-network IP, or 127.0.0.1:3003 if you've published it to the host's
# loopback — see docker-compose.yml's pangolin-tunnel service comment).
PANGOLIN_TUNNEL_SSH_HOST=your_pangolin_host
PANGOLIN_TUNNEL_SSH_USER=your_ssh_user
PANGOLIN_TUNNEL_SSH_KEY_HOST_PATH=/path/to/ssh/private_key
PANGOLIN_TUNNEL_TARGET=127.0.0.1:3003

# ── Authentik (see config/authentik.php) ───────────────────────────────
AUTHENTIK_VIP=
AUTHENTIK_API_TOKEN=

# Single SSH key used to reach all 3 Authentik nodes for both the native
# Monitor checks and logs_viewer.py's docker logs/journalctl fetch — must
# be passphrase-less, since the queue-worker container has no stdin to
# answer a passphrase prompt (a passphrase-protected key silently fails
# headlessly, same lesson learned on Pangolin's SSH slots).
AUTHENTIK_SSH_USERNAME=
AUTHENTIK_SSH_KEY_PATH=

AUTHENTIK_HAPROXY_STATS_USER=admin
AUTHENTIK_HAPROXY_STATS_PASS=

# Real node IPs are treated as sensitive (same convention as PANGOLIN_NODES_JSON)
# — kept only in .env, never in config/authentik.php.
# Shape: [{"ip":"10.x.x.x","name":"ak-node-1","base_priority":100}, ...]
AUTHENTIK_NODES_JSON=[]
