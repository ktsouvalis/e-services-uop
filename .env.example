# This app is normally run via Docker Compose (see ../developing or
# ../production), which injects its own outer .env into this container —
# this file is only a fallback for running `php artisan` directly outside
# Docker, so it's kept in sync with that outer .env.example's variable set
# rather than Laravel's stock scaffold defaults.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dgu
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REVERB_APP_ID=dev-app
REVERB_APP_KEY=dev-key
REVERB_APP_SECRET=dev-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY=dev-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

LDAP_HOST=your_ldap_host
LDAP_PORT=your_ldap_port
LDAP_SSL=true_or_false
LDAP_USERNAME=your_ldap_username
LDAP_PASSWORD=your_ldap_password
LDAP_BASE_DN=  your_ldap_base_dn

# ── Pangolin (see config/pangolin.php) ────────────────────────────────
# Integration API — a separate opt-in Pangolin feature, not the dashboard.
PANGOLIN_API_BASE_URL=https://your-domain/int-api
PANGOLIN_ORG_SLUG=your_org_slug
PANGOLIN_API_KEY=your_api_key
PANGOLIN_VIP=

# SSH used both by logs_viewer.py (shelled out to) and the native Newt
# reachability check.
PANGOLIN_SSH_USERNAME=
PANGOLIN_SSH_KEY_PATH=

# Real node IPs are treated as sensitive (same convention pangolin-utils
# itself uses for its own git-ignored config.yml) — kept only in .env,
# never in config/pangolin.php.
# Shape: [{"ip":"10.x.x.x","name":"pangolin-node-1","base_priority":100}, ...]
PANGOLIN_NODES_JSON=[]

# Newt agent hosts use their own dedicated, passphrase-less automation key
# (a personal/passphrase-protected key can't be used headlessly) — do not
# reuse PANGOLIN_SSH_KEY_PATH here.
PANGOLIN_NEWT_SSH_USERNAME=
PANGOLIN_NEWT_SSH_KEY_PATH=
# Shape: [{"ip":"10.x.x.x","name":"patra"}, ...]
PANGOLIN_NEWT_HOSTS_JSON=[]

# Postgres — used by logs_viewer.py to resolve Newt access-log sessions
# into human-readable names (site/client/resource) instead of raw IPs/IDs.
PANGOLIN_POSTGRES_USER=postgres
PANGOLIN_POSTGRES_PASSWORD=
PANGOLIN_POSTGRES_DB=pangolin
